#!/usr/bin/env python3
"""presetctl - display presets for Hyprland (Omarchy).

A preset says which apps go on which screen. Applying it reuses the matching
windows that are already open (moving them where they belong) and launches
only what is missing, so pressing the same preset twice changes nothing.

    presetctl list [--json]          presets, screens, and what is open now
    presetctl apply <id> [--dry-run] [--json] [--notify]
    presetctl capture [--name NAME]  save the current layout as a new preset
    presetctl delete <id>
    presetctl rename <id> <name>     presetctl move <id> <+1|-1>
    presetctl new [--name NAME]      create an empty preset (to fill in the editor)
    presetctl show <id> --json       a preset as the editor sees it, per screen
    presetctl save <id> --data JSON  write what the editor changed
    presetctl restore-hidden        bring back windows a preset minimized
    presetctl monitors               how screen names resolve on this machine
    presetctl path                   print the presets file path

A screen lists its apps (Hyprland tiles them as it sees fit), or gives "tiles":
a tree of splits that pins every window to a place (see README, "Free layout").

The presets file is ~/.config/omarchy-presets/presets.json (override with
PRESETCTL_CONFIG). Only the Python standard library and hyprctl are used.
"""

import argparse
import datetime
import json
import os
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
import unicodedata

CONFIG_PATH = os.environ.get("PRESETCTL_CONFIG") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "omarchy-presets",
    "presets.json",
)

MINIMIZED_WORKSPACE = "special:minimized"
MINIMIZED_TAG_PREFIX = "omarchy-minimized-from-"
DEFAULT_TIMEOUT = 20.0
POLL_INTERVAL = 0.25
MAX_COUNT = 12
LAYOUTS = ("dwindle", "scrolling", "floating")
SPLITS = ("right", "down")     # where the "b" side of a split goes, relative to "a"
PRESELECT = {"right": "r", "down": "d"}
MAX_TILES = 16
MAX_DEPTH = 10
PARK_WORKSPACE = "special:presets-park"
# A desktop id such as org.gnome.Nautilus or com.stremio.Stremio.
REVERSE_DNS = re.compile(r"^[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+){2,}$")
MATCH_TOLERANCE = 0.05

# Screen keys a preset may use, in English or French.
POSITION_ALIASES = {
    "left": "left", "gauche": "left",
    "middle": "middle", "center": "middle", "centre": "middle", "milieu": "middle", "main": "middle",
    "right": "right", "droite": "right",
}

# Tokens that only wrap the real program in an exec line.
WRAPPERS = {"uwsm-app", "uwsm", "app", "--", "setsid", "exec", "env", "nohup", "systemd-run", "-f", "--fork"}
TERMINAL_CLASS_FLAGS = {
    "foot": ("-a", "--app-id"),
    "footclient": ("-a", "--app-id"),
    "alacritty": ("--class",),
    "kitty": ("--class",),
    "ghostty": ("--class",),
    "wezterm": ("--class",),
}


class PresetError(Exception):
    pass


# --------------------------------------------------------------------------
# Hyprland access
# --------------------------------------------------------------------------

class Hyprland:
    """Thin wrapper over hyprctl. Tests replace it with a fake."""

    def __init__(self, dry_run=False, log=None):
        self.dry_run = dry_run
        self.log = log or (lambda msg: None)
        self.dispatched = []

    _socket_path = None

    @classmethod
    def socket_path(cls):
        """Hyprland's request socket, or "" when it cannot be found."""
        if cls._socket_path is None:
            sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
            runtime = os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
            path = os.path.join(runtime, "hypr", sig, ".socket.sock") if sig else ""
            cls._socket_path = path if path and os.path.exists(path) else ""
        return cls._socket_path

    def request(self, message):
        """Send one request to Hyprland and return its reply as text.

        Talks to the socket directly: an apply sends dozens of requests, and
        starting a hyprctl process for each one is what made it feel slow.
        Falls back to hyprctl when the socket is not reachable.
        """
        path = self.socket_path()
        if path:
            try:
                with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                    sock.settimeout(5)
                    sock.connect(path)
                    sock.sendall(message.encode("utf-8"))
                    chunks = []
                    while True:
                        chunk = sock.recv(65536)
                        if not chunk:
                            break
                        chunks.append(chunk)
                return b"".join(chunks).decode("utf-8", "replace")
            except OSError:
                Hyprland._socket_path = ""
        return self._hyprctl(message)

    def _hyprctl(self, message):
        json_flag = message.startswith("j/")
        if json_flag:
            message = message[2:]
        verb, _, rest = message.partition(" ")
        cmd = ["hyprctl"] + (["-j"] if json_flag else []) + [verb] + ([rest] if rest else [])
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        except FileNotFoundError:
            raise PresetError("hyprctl not found: is Hyprland running?")
        except subprocess.TimeoutExpired:
            raise PresetError("hyprctl is not responding")
        return out.stdout if out.returncode == 0 else (out.stdout + out.stderr or "error")

    def _json(self, what):
        text = self.request("j/" + what)
        try:
            return json.loads(text)
        except ValueError:
            raise PresetError("hyprctl %s returned an unreadable response: %s" % (what, text.strip()[:120]))

    def monitors(self):
        return self._json("monitors")

    def clients(self):
        return self._json("clients")

    def workspaces(self):
        return self._json("workspaces")

    def workspace_layout(self, workspace):
        """dwindle, scrolling or floating as Omarchy reports it; "" when unknown."""
        if not shutil.which("omarchy-hyprland-workspace-layout-current"):
            return ""
        try:
            return subprocess.run(["omarchy-hyprland-workspace-layout-current", str(workspace)],
                                  capture_output=True, text=True, timeout=5).stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            return ""

    def option_int(self, name):
        """Integer value of a Hyprland option, or None when it cannot be read."""
        try:
            value = json.loads(self.request("j/getoption " + name))
        except (OSError, ValueError, PresetError):
            return None
        # Hyprland reports booleans as "bool", numbers as "int".
        for key in ("int", "bool"):
            if key in value:
                try:
                    return int(value[key])
                except (TypeError, ValueError):
                    return None
        return None

    def dispatch(self, lua):
        self.dispatched.append(lua)
        if self.dry_run:
            self.log("[dry-run] " + lua)
            return True
        try:
            reply = self.request("dispatch " + lua).strip()
        except PresetError as exc:
            reply = str(exc)
        ok = reply.lower() in ("ok", "")
        if not ok:
            self.log("dispatch refused: %s -> %s" % (lua, reply))
        return ok

    def eval(self, lua):
        self.dispatched.append(lua)
        if self.dry_run:
            self.log("[dry-run] eval " + lua)
            return True
        try:
            reply = self.request("eval " + lua).strip()
        except PresetError:
            return False
        return not reply.lower().startswith("error")

    def sleep(self, seconds):
        time.sleep(seconds)


def lua_str(value):
    """Quote a Python string as a Lua string literal."""
    s = str(value)
    s = s.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n").replace("\r", "\\r").replace("\0", "")
    return '"' + s + '"'


