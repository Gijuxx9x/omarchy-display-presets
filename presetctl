def notify(summary, body="", urgent=False):
    for tool in ("omarchy-notification-send", "notify-send"):
        if shutil.which(tool):
            cmd = [tool]
            if urgent:
                cmd += ["-u", "critical"]
            subprocess.run(cmd + [summary, body], capture_output=True, timeout=5)
            return


def cmd_list(args):
    hypr = Hyprland()
    try:
        data, exists = load_config()
        error = ""
    except PresetError as exc:
        data, exists, error = {"presets": []}, True, str(exc)
    out = describe(data, hypr.monitors(), hypr.clients(), exists)
    out["error"] = error
    if args.json:
        print(json.dumps(out, ensure_ascii=False))
        return 0
    if error:
        print("! " + error)
    print("Screens: " + "  ".join("%s=%s (%s)" % (m["position"], m["name"], m["label"]) for m in out["monitors"]))
    if not out["presets"]:
        print("No presets in %s" % out["config"])
    for p in out["presets"]:
        mark = "●" if p["active"] else "○"
        print("%s %d. %s [%s]%s" % (mark, p["index"], p["name"], p["id"], "  ! " + p["error"] if p["error"] else ""))
        for s in p["screens"]:
            apps = ", ".join("%s%s" % (a["name"], " ×%d" % a["count"] if a["count"] > 1 else "") for a in s["apps"])
            print("     %-9s %s" % (s["monitor"], apps or "—"))
    return 0


def cmd_apply(args):
    log = (lambda msg: print(msg, file=sys.stderr)) if (args.verbose or args.dry_run) else None
    hypr = Hyprland(dry_run=args.dry_run, log=log)
    data, _ = load_config()
    _, preset = find_preset(data, args.preset)
    result = apply_preset(preset, hypr, timeout=args.timeout, log=log)
    result["preset"] = preset.get("name") or args.preset
    if args.dry_run:
        result["dispatched"] = hypr.dispatched
    if args.json:
        print(json.dumps(result, ensure_ascii=False))
    else:
        print("%s: %d kept, %d moved, %d launched%s" % (
            result["preset"], result["kept"], result["moved"], result["launched"],
            ", %d hidden" % result["hidden"] if result["hidden"] else ""))
        for w in result["warnings"]:
            print("  ! " + w)
    if args.notify and result["warnings"]:
        notify("Preset \"%s\"" % result["preset"], "\n".join(result["warnings"]), urgent=not result["ok"])
    return 0 if result["ok"] else 2


def cmd_capture(args):
    hypr = Hyprland()
    data, _ = load_config()
    preset = capture(hypr.monitors(), hypr.clients(), args.name)
    preset = dict([("id", unique_id(data, slugify(preset["name"])))] + list(preset.items()))
    if not preset.get("focus"):
        preset.pop("focus", None)
    data.setdefault("version", 1)
    data["presets"].append(preset)
    save_config(data)
    if args.json:
        print(json.dumps({"ok": True, "id": preset["id"], "name": preset["name"]}, ensure_ascii=False))
    else:
        print("Preset \"%s\" saved (%s)" % (preset["name"], preset["id"]))
    return 0


def cmd_new(args):
    data, _ = load_config()
    name = " ".join((args.name or "").split())[:60] or "Preset " + str(len(data["presets"]) + 1)
    preset = {"id": unique_id(data, slugify(name)), "name": name, "screens": {}}
    data.setdefault("version", 1)
    data["presets"].append(preset)
    save_config(data)
    if args.json:
        print(json.dumps({"ok": True, "id": preset["id"], "name": name}, ensure_ascii=False))
    else:
        print("Preset \"%s\" created (%s)" % (name, preset["id"]))
    return 0


def cmd_show(args):
    data, _ = load_config()
    out = editable(data, Hyprland().monitors(), args.preset)
    print(json.dumps(out, ensure_ascii=False, indent=None if args.json else 2))
    return 0


def cmd_save(args):
    try:
        edit = json.loads(args.data)
    except ValueError as exc:
        raise PresetError("invalid JSON: %s" % exc)
    data, exists = load_config()
    if not exists:
        raise PresetError("no presets file")
    preset = apply_edit(data, Hyprland().monitors(), args.preset, edit)
    save_config(data)
    if args.json:
        print(json.dumps({"ok": True, "id": preset["id"]}, ensure_ascii=False))
    else:
        print("Preset \"%s\" saved" % preset.get("name"))
    return 0


def cmd_delete(args):
    data, exists = load_config()
    if not exists:
        raise PresetError("no presets file")
    index, preset = find_preset(data, args.preset)
    del data["presets"][index]
    save_config(data)
    print("Preset \"%s\" deleted (backup: presets.json.bak)" % (preset.get("name") or args.preset))
    return 0


def cmd_rename(args):
    data, exists = load_config()
    if not exists:
        raise PresetError("no presets file")
    name = " ".join(args.name.split())[:60]
    if not name:
        raise PresetError("the name is empty")
    index, preset = find_preset(data, args.preset)
    # Keep the id stable so keybindings that name it keep working.
    preset["id"] = preset_id(preset, index)
    preset["name"] = name
    save_config(data)
    print("Preset renamed to \"%s\"" % name)
    return 0


def cmd_move(args):
    data, exists = load_config()
    if not exists:
        raise PresetError("no presets file")
    index, preset = find_preset(data, args.preset)
    presets = data["presets"]
    preset["id"] = preset_id(preset, index)
    target = max(0, min(len(presets) - 1, index + args.delta))
    if target != index:
        presets.insert(target, presets.pop(index))
        save_config(data)
    print(target + 1)
    return 0


def cmd_restore_hidden(args):
    hypr = Hyprland()
    clients = hypr.clients()
    restored = unpark(hypr, hypr.monitors(), clients)
    for w in clients:
        if not is_minimized(w):
            continue
        tags = [t for t in window_tags(w) if t.startswith(MINIMIZED_TAG_PREFIX)]
        if not tags:
            continue
        ws = tags[0][len(MINIMIZED_TAG_PREFIX):]
        for tag in tags:
            hypr.dispatch("hl.dsp.window.tag({ tag = %s, window = %s })" % (lua_str("-" + tag), lua_str("address:" + w["address"])))
        if hypr.dispatch("hl.dsp.window.move({ workspace = %s, follow = false, window = %s })" % (
                lua_str(ws), lua_str("address:" + w["address"]))):
            restored += 1
    print("%d window(s) restored" % restored)
    return 0


def cmd_monitors(args):
    mons = sorted_monitors(Hyprland().monitors())
    names = position_names(len(mons))
    for i, m in enumerate(mons):
        print("%-7s  %-9s  %-14s  ws %-4s  %s" % (
            names[i], m.get("name"), monitor_label(m), (m.get("activeWorkspace") or {}).get("id"), m.get("description", "")))
    print("\nAccepted keys: left, middle/center, right, 1..N, name (DP-1), desc:<text> or a word from the model (e.g. Legion). French aliases (gauche, milieu, centre, droite) also work.")
    return 0


def cmd_path(args):
    print(CONFIG_PATH)
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="presetctl", description="Display presets for Hyprland / Omarchy")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("list", help="list presets")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("apply", help="apply a preset (id, name or number)")
    p.add_argument("preset")
    p.add_argument("--dry-run", action="store_true", help="show what would be done without changing anything")
    p.add_argument("--json", action="store_true")
    p.add_argument("--notify", action="store_true", help="notify on problems (for keyboard shortcuts)")
    p.add_argument("--timeout", type=float, default=None, help="seconds to wait for launched windows")
    p.add_argument("-v", "--verbose", action="store_true")
    p.set_defaults(func=cmd_apply)

    p = sub.add_parser("capture", help="save the current layout as a preset")
    p.add_argument("--name")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_capture)

    p = sub.add_parser("new", help="create an empty preset")
    p.add_argument("--name")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_new)

    p = sub.add_parser("show", help="a preset as the editor sees it")
    p.add_argument("preset")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("save", help="save the editor's changes (JSON)")
    p.add_argument("preset")
    p.add_argument("--data", required=True, help="JSON : name, description, others, focus, screens")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_save)

    p = sub.add_parser("delete", help="delete a preset")
    p.add_argument("preset")
    p.set_defaults(func=cmd_delete)

    p = sub.add_parser("rename", help="rename a preset (the id does not change)")
    p.add_argument("preset")
    p.add_argument("name")
    p.set_defaults(func=cmd_rename)

    p = sub.add_parser("move", help="move a preset in the list (e.g. move work -1)")
    p.add_argument("preset")
    p.add_argument("delta", type=int)
    p.set_defaults(func=cmd_move)

    p = sub.add_parser("restore-hidden", help="bring back windows a preset minimized")
    p.set_defaults(func=cmd_restore_hidden)

    p = sub.add_parser("monitors", help="show how screens are named")
    p.set_defaults(func=cmd_monitors)

    p = sub.add_parser("path", help="path of the presets file")
    p.set_defaults(func=cmd_path)

    args = parser.parse_args(argv)
    # Being stopped mid-layout must still bring the parked windows back (the
    # finally in arrange_target), so these signals end the run like an error.
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda signum, frame: sys.exit(128 + signum))
    try:
        return args.func(args)
    except PresetError as exc:
        if getattr(args, "json", False):
            print(json.dumps({"ok": False, "error": str(exc)}, ensure_ascii=False))
        print("presetctl: " + str(exc), file=sys.stderr)
        if getattr(args, "notify", False):
            notify("Preset", str(exc), urgent=True)
        return 1


if __name__ == "__main__":
    sys.exit(main())
