# Editing (what the panel's editor reads and writes)
# --------------------------------------------------------------------------

APP_FIELDS = ("name", "exec", "count", "class", "title", "icon", "reuse")
OTHERS_VALUES = ("keep", "minimize")


def clean_app(raw):
    """Validate one app coming from the editor; returns a dict ready for the file."""
    if not isinstance(raw, dict):
        raise PresetError("invalid app")
    command = " ".join(str(raw.get("exec") or "").split())
    if not command:
        raise PresetError("an app has no command")
    app = {}
    for key, value in raw.items():
        if key not in APP_FIELDS or value in (None, ""):
            continue
        app[key] = value
    app["exec"] = command
    app["name"] = " ".join(str(raw.get("name") or "").split())[:60] or derive_class(command) or "app"
    count = app_count(raw)
    if count <= 1:
        app.pop("count", None)
    else:
        app["count"] = count
    if app.get("reuse") is not False:
        app.pop("reuse", None)
    for key in ("class", "title"):
        if key in app:
            app[key] = str(app[key])
            compile_regex(app[key], key, app["name"])
    return app


def editable(data, monitors, wanted):
    """The preset laid out per connected screen, with its full app entries."""
    index, preset = find_preset(data, wanted)
    mons = sorted_monitors(monitors)
    names = position_names(len(mons))
    columns = [{"position": names[i], "monitor": m.get("name"), "label": monitor_label(m),
                "key": None, "workspace": None, "layout": "", "apps": [], "tiles": None}
               for i, m in enumerate(mons)]
    unresolved = []
    for key, screen in preset_screens(preset):
        mon = resolve_screen(key, mons)
        if mon is None:
            unresolved.append(key)
            continue
        column = columns[mons.index(mon)]
        if column["key"] is None:
            column["key"] = key
            column["workspace"] = screen.get("workspace")
            column["layout"] = screen.get("layout") or ""
        # Two keys can point at one screen (say "left" and "DP-1"): show their apps together.
        if isinstance(screen.get("tiles"), dict) and screen["tiles"]:
            if column["tiles"] is None:
                column["tiles"] = clean_tree(screen["tiles"])
        else:
            column["apps"] = column["apps"] + screen_apps(screen)
    focus = ""
    if preset.get("focus"):
        mon = resolve_screen(preset["focus"], mons)
        if mon is not None:
            focus = names[mons.index(mon)]
    return {
        "id": preset_id(preset, index),
        "name": str(preset.get("name") or preset_id(preset, index)),
        "description": str(preset.get("description") or ""),
        "others": "minimize" if preset.get("others") == "minimize" else "keep",
        "focus": focus,
        "screens": columns,
        "unresolved": unresolved,
    }


def apply_edit(data, monitors, wanted, edit):
    """Write the editor's changes into data (in place) and return the preset."""
    if not isinstance(edit, dict):
        raise PresetError("invalid editor data")
    index, preset = find_preset(data, wanted)
    preset["id"] = preset_id(preset, index)
    mons = sorted_monitors(monitors)
    names = position_names(len(mons))

    if "name" in edit:
        name = " ".join(str(edit["name"]).split())[:60]
        if not name:
            raise PresetError("the name is empty")
        preset["name"] = name
    if "description" in edit:
        description = " ".join(str(edit["description"]).split())[:200]
        if description:
            preset["description"] = description
        else:
            preset.pop("description", None)
    if "others" in edit:
        if edit["others"] not in OTHERS_VALUES:
            raise PresetError("\"others\" must be keep or minimize")
        if edit["others"] == "minimize":
            preset["others"] = "minimize"
        else:
            preset.pop("others", None)

    if "screens" in edit:
        incoming = edit["screens"]
        if not isinstance(incoming, dict):
            raise PresetError("\"screens\" must be an object of position -> apps")
        old = preset_screens(preset)
        new = {}
        used_keys = set()
        # Keep every key we are not editing (screens not plugged in, odd aliases) as it was.
        for key, screen in old:
            mon = resolve_screen(key, mons)
            if mon is None:
                new[key] = screen
                used_keys.add(key)
        for i, mon in enumerate(mons):
            position = names[i]
            if position not in incoming:
                for key, screen in old:
                    if resolve_screen(key, mons) is mon and key not in used_keys:
                        new[key] = screen
                        used_keys.add(key)
                        break
                continue
            value = incoming[position]
            if isinstance(value, dict):
                apps, tiles = value.get("apps") or [], value.get("tiles")
            else:
                apps, tiles = value, None
            if not isinstance(apps, list):
                raise PresetError("the apps of \"%s\" must be a list" % position)
            apps = [clean_app(a) for a in apps]
            tiles = clean_tree(tiles) if tiles else None
            existing_key, existing = next(
                ((k, sc) for k, sc in old if resolve_screen(k, mons) is mon and k not in used_keys), (None, {}))
            screen = {k: v for k, v in existing.items() if k not in ("apps", "tiles")}
            if not apps and not tiles and not screen:
                continue
            if tiles:
                screen["tiles"] = tiles    # a tile tree replaces the flat list
            else:
                screen["apps"] = apps
            key = existing_key if existing_key is not None else position
            used_keys.add(key)
            new[key] = screen
        preset["screens"] = new

    if "focus" in edit:
        wanted_focus = str(edit["focus"] or "")
        current = ""
        if preset.get("focus"):
            mon = resolve_screen(preset["focus"], mons)
            if mon is not None:
                current = names[mons.index(mon)]
        if wanted_focus != current:
            if not wanted_focus:
                preset.pop("focus", None)
            elif wanted_focus in names:
                preset["focus"] = wanted_focus
            else:
                raise PresetError("unknown screen for focus: %s" % wanted_focus)
    return preset


