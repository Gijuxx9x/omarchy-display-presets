def desktop_dirs():
    home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    dirs = [home] + (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
    return [os.path.join(d, "applications") for d in dirs if d]


_DESKTOP_INDEX = None


def desktop_index():
    """[(file stem, fields)] of every visible desktop entry, read once per run.

    A capture looks up one entry per window; reading every .desktop file again
    for each of them was the slow part.
    """
    global _DESKTOP_INDEX
    if _DESKTOP_INDEX is not None:
        return _DESKTOP_INDEX
    index, seen = [], set()
    for directory in desktop_dirs():
        try:
            names = sorted(os.listdir(directory))
        except OSError:
            continue
        for name in names:
            # An entry in ~/.local/share hides the one with the same name further down.
            if not name.endswith(".desktop") or name in seen:
                continue
            seen.add(name)
            fields = {}
            try:
                with open(os.path.join(directory, name), encoding="utf-8", errors="replace") as fh:
                    section = ""
                    for line in fh:
                        line = line.strip()
                        if line.startswith("["):
                            section = line
                        elif section == "[Desktop Entry]" and "=" in line:
                            k, v = line.split("=", 1)
                            fields.setdefault(k.strip(), v.strip())
            except OSError:
                continue
            if fields.get("Hidden", "").lower() == "true":
                continue
            index.append((name[: -len(".desktop")], fields))
    _DESKTOP_INDEX = index
    return index


def desktop_entry_for_class(klass):
    """{exec, name, icon} of the desktop entry that claims a window class."""
    if not klass:
        return {}
    wanted = klass.lower()
    matches = []
    for stem, fields in desktop_index():
        wm = fields.get("StartupWMClass", "").lower()
        if wm == wanted:
            matches.insert(0, fields)
        elif stem.lower() == wanted:
            matches.append(fields)
    for fields in matches:
        command = strip_field_codes(fields.get("Exec", "")).strip()
        if command and command_installed(command):
            return {"exec": command, "name": fields.get("Name", ""), "icon": fields.get("Icon", "")}
    # A browser started from its own entry: helium windows come from helium-browser.
    for stem, fields in desktop_index():
        command = strip_field_codes(fields.get("Exec", "")).strip()
        if command and wanted in [c.lower() for c in derive_classes(command)[1:]] and command_installed(command):
            return {"exec": command, "name": fields.get("Name", ""), "icon": fields.get("Icon", "")}
    return {}


def webapp_url(cmdline):
    """The address of a Chromium --app window's command line, or ""."""
    for tok in exec_tokens(cmdline):
        if tok.startswith("--app="):
            return tok[len("--app="):]
    return ""


def strip_field_codes(command):
    """An Exec= line without %U-style codes and flatpak's @@u ... @@ markers."""
    command = re.sub(r"\s*%[fFuUdDnNickvm](?=\s|$)", "", str(command or ""))
    return re.sub(r"\s*@@[uU]?(?=\s|$)", "", command).strip()


def proc_cmdline(pid):
    try:
        with open("/proc/%d/cmdline" % int(pid), "rb") as fh:
            parts = [p.decode("utf-8", "replace") for p in fh.read().split(b"\0") if p]
    except (OSError, ValueError, TypeError):
        return ""
    return " ".join(shlex.quote(p) for p in parts)


def app_from_window(window):
    klass = window.get("class") or window.get("initialClass") or ""
    entry = desktop_entry_for_class(klass)
    cmdline = "" if entry.get("exec") else proc_cmdline(window.get("pid"))
    url = webapp_url(cmdline) if klass.startswith("chrome-") else ""
    if url:
        # A web app: relaunch it the way Omarchy does, in whatever browser is the default.
        cmdline = "omarchy-launch-webapp " + shlex.quote(url)
    command = entry.get("exec") or cmdline or klass
    name = entry.get("name") or (klass[len("chrome-"):].split("_")[0] if klass.startswith("chrome-") else klass)
    app = {"name": name, "exec": command, "class": "^" + re.escape(klass) + "$", "count": 1}
    if entry.get("icon"):
        app["icon"] = entry["icon"]
    return app


def capture(monitors, clients, name=None):
    mons = sorted_monitors(monitors)
    names = position_names(len(mons))
    screens = {}
    for i, m in enumerate(mons):
        ws = (m.get("activeWorkspace") or {}).get("id")
        here = [w for w in clients
                if claimable(w) and not is_minimized(w)
                and (w.get("workspace") or {}).get("id") == ws
                and (w.get("class") or w.get("initialClass"))]
        here.sort(key=lambda w: ((w.get("at") or [0, 0])[0], (w.get("at") or [0, 0])[1]))
        apps = []
        for w in here:
            app = app_from_window(w)
            same = next((a for a in apps if a["class"] == app["class"] and a["exec"] == app["exec"]), None)
            if same:
                same["count"] += 1
            else:
                apps.append(app)
        if apps:
            screens[names[i]] = {"apps": apps}
    if not screens:
        raise PresetError("no visible window to capture")
    label = name or "Disposition " + datetime.datetime.now().strftime("%d/%m %H:%M")
    return {"name": label, "icon": "", "focus": None, "screens": screens}


def unique_id(data, base):
    existing = {preset_id(p, i) for i, p in enumerate(data.get("presets", []))}
    candidate, n = base, 2
    while candidate in existing:
        candidate = "%s-%d" % (base, n)
        n += 1
    return candidate


