def load_config(path=None):
    path = path or CONFIG_PATH
    if not os.path.exists(path):
        return {"version": 1, "presets": []}, False
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except ValueError as exc:
        raise PresetError("presets.json is not valid JSON: %s" % exc)
    except OSError as exc:
        raise PresetError("cannot read %s: %s" % (path, exc))
    if not isinstance(data, dict) or not isinstance(data.get("presets", []), list):
        raise PresetError("presets.json must contain an object with a \"presets\" list")
    data.setdefault("presets", [])
    if not all(isinstance(p, dict) for p in data["presets"]):
        raise PresetError("every entry of \"presets\" must be an object")
    return data, True


def save_config(data, path=None):
    path = path or CONFIG_PATH
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    if os.path.exists(path):
        shutil.copy2(path, path + ".bak")
    fd, tmp = tempfile.mkstemp(prefix=".presets-", suffix=".json", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(data, fh, indent=2, ensure_ascii=False)
            fh.write("\n")
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def slugify(text):
    text = unicodedata.normalize("NFKD", str(text)).encode("ascii", "ignore").decode("ascii")
    text = re.sub(r"[^a-zA-Z0-9]+", "-", text).strip("-").lower()
    return text or "preset"


def preset_id(preset, index):
    return str(preset.get("id") or slugify(preset.get("name") or "preset-%d" % (index + 1)))


def find_preset(data, wanted):
    wanted = str(wanted)
    presets = data.get("presets", [])
    for i, p in enumerate(presets):
        if preset_id(p, i) == wanted:
            return i, p
    for i, p in enumerate(presets):
        if slugify(p.get("name", "")) == slugify(wanted):
            return i, p
    if wanted.isdigit() and 1 <= int(wanted) <= len(presets):
        return int(wanted) - 1, presets[int(wanted) - 1]
    raise PresetError("preset not found: %s" % wanted)


def preset_screens(preset):
    """[(key, screen_dict)] in file order, accepting a dict or a list."""
    screens = preset.get("screens") or {}
    out = []
    if isinstance(screens, dict):
        for key, screen in screens.items():
            out.append((str(key), screen if isinstance(screen, dict) else {"apps": screen}))
    elif isinstance(screens, list):
        for i, screen in enumerate(screens):
            if isinstance(screen, dict):
                out.append((str(screen.get("screen", i + 1)), screen))
    return out


def screen_apps(screen):
    if isinstance(screen.get("tiles"), dict) and screen["tiles"]:
        # A tile tree owns the screen: one window per tile, in tree order.
        return [dict(a, count=1) for a in tile_leaves(screen["tiles"])]
    apps = screen.get("apps") or []
    if isinstance(apps, dict):
        apps = [apps]
    return [a for a in apps if isinstance(a, dict)]


def is_split(node):
    return isinstance(node, dict) and "split" in node


def tile_leaves(node):
    """The apps of a tile tree, "a" side first (the order windows are claimed in)."""
    if is_split(node):
        return tile_leaves(node.get("a")) + tile_leaves(node.get("b"))
    return [node] if isinstance(node, dict) else []


def split_ratio(node):
    try:
        ratio = float(node.get("ratio", 0.5))
    except (TypeError, ValueError):
        ratio = 0.5
    return max(0.1, min(0.9, ratio))


def tile_rects(node, x=0.0, y=0.0, w=1.0, h=1.0):
    """[(leaf, (x, y, w, h))] with every tile as a fraction of its screen."""
    if not is_split(node):
        return [(node, (x, y, w, h))]
    r = split_ratio(node)
    if node.get("split") == "down":
        return tile_rects(node["a"], x, y, w, h * r) + tile_rects(node["b"], x, y + h * r, w, h * (1 - r))
    return tile_rects(node["a"], x, y, w * r, h) + tile_rects(node["b"], x + w * r, y, w * (1 - r), h)


def clean_tree(node):
    """Validate a tile tree from the file or the editor and return a tidy copy."""
    leaves = [0]

    def walk(n, depth):
        if depth > MAX_DEPTH:
            raise PresetError("the layout is nested too deeply")
        if not isinstance(n, dict):
            raise PresetError("invalid tile in the layout")
        if "split" in n:
            if n["split"] not in SPLITS:
                raise PresetError("\"split\" must be %s" % " or ".join(SPLITS))
            if "a" not in n or "b" not in n:
                raise PresetError("a split needs both \"a\" and \"b\"")
            out = {"split": n["split"]}
            ratio = split_ratio(n)
            if abs(ratio - 0.5) > 0.0005:
                out["ratio"] = round(ratio, 3)
            out["a"] = walk(n["a"], depth + 1)
            out["b"] = walk(n["b"], depth + 1)
            return out
        leaves[0] += 1
        if leaves[0] > MAX_TILES:
            raise PresetError("too many tiles (%d at most)" % MAX_TILES)
        app = clean_app(n)
        app.pop("count", None)
        return app

    return walk(node, 0)


def app_count(app):
    try:
        n = int(app.get("count", 1))
    except (TypeError, ValueError):
        n = 1
    return max(0, min(MAX_COUNT, n))


