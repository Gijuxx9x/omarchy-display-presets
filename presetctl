# Applying
# --------------------------------------------------------------------------

def move_window(hypr, window, workspace):
    if is_minimized(window):
        for tag in window_tags(window):
            if tag.startswith(MINIMIZED_TAG_PREFIX):
                hypr.dispatch("hl.dsp.window.tag({ tag = %s, window = %s })" % (
                    lua_str("-" + tag), lua_str("address:" + window["address"])))
    return hypr.dispatch("hl.dsp.window.move({ workspace = %s, follow = false, window = %s })" % (
        lua_str(workspace), lua_str("address:" + window["address"])))


def show_workspace(hypr, target, workspaces):
    """Make an explicit workspace the visible one on its monitor."""
    mon = target["monitor"]["name"]
    ws = target["workspace"]
    current = next((w for w in workspaces if str(w.get("id")) == ws or w.get("name") == ws), None)
    if current is not None and current.get("monitor") != mon:
        hypr.dispatch("hl.dsp.workspace.move({ workspace = %s, monitor = %s })" % (lua_str(ws), lua_str(mon)))
    hypr.dispatch("hl.dsp.focus({ monitor = %s })" % lua_str(mon))
    hypr.dispatch("hl.dsp.focus({ workspace = %s })" % lua_str(ws))


def set_layout(hypr, target):
    ws = target["workspace"]
    if not ws.isdigit():
        return
    current = "" if hypr.dry_run else hypr.workspace_layout(ws)
    if current == target["layout"]:
        return
    hypr.eval("o.workspace_mode({ workspace = %s, mode = %s })" % (lua_str(ws), lua_str(target["layout"])))


def launch(hypr, slot):
    command = strip_field_codes(slot["app"].get("exec") or "")
    if not command:
        return False
    rule = "[workspace %s silent] " % slot["target"]["workspace"]
    return hypr.dispatch("hl.dsp.exec_cmd(%s)" % lua_str(rule + command))


def annotate_tree(node, slots):
    """Copy of a tile tree whose leaves carry their slot (taken from slots in order)."""
    if is_split(node):
        out = dict(node)
        out["a"] = annotate_tree(node["a"], slots)
        out["b"] = annotate_tree(node["b"], slots)
        return out
    return {"slot": slots.pop(0)}


def prune_tree(node):
    """Drop tiles whose window never showed up; the neighbour takes their space."""
    if "slot" in node:
        return node if node["slot"]["window"] is not None else None
    a, b = prune_tree(node["a"]), prune_tree(node["b"])
    if a is None or b is None:
        return a or b
    return dict(node, a=a, b=b)


def first_window(node):
    while "slot" not in node:
        node = node["a"]
    return node["slot"]["window"]


def tree_matches(tree, clients, workspace):
    """Are the windows already laid out like the tree, give or take the gaps?"""
    leaves = [(n["slot"]["window"]["address"], r) for n, r in tile_rects(tree)]
    by_addr = {w["address"]: w for w in clients}
    wins = []
    for addr, rect in leaves:
        w = by_addr.get(addr)
        if w is None or str((w.get("workspace") or {}).get("id")) != workspace or w.get("floating"):
            return False
        if not w.get("at") or not w.get("size"):
            return False
        wins.append((w, rect))
    x0 = min(w["at"][0] for w, _ in wins)
    y0 = min(w["at"][1] for w, _ in wins)
    x1 = max(w["at"][0] + w["size"][0] for w, _ in wins)
    y1 = max(w["at"][1] + w["size"][1] for w, _ in wins)
    width, height = max(1, x1 - x0), max(1, y1 - y0)
    for w, (rx, ry, rw, rh) in wins:
        cx = (w["at"][0] + w["size"][0] / 2 - x0) / width
        cy = (w["at"][1] + w["size"][1] / 2 - y0) / height
        if abs(cx - (rx + rw / 2)) > MATCH_TOLERANCE or abs(cy - (ry + rh / 2)) > MATCH_TOLERANCE:
            return False
        if abs(w["size"][0] / width - rw) > MATCH_TOLERANCE * 1.5 or abs(w["size"][1] / height - rh) > MATCH_TOLERANCE * 1.5:
            return False
    return True


def wait_for_dwindle(hypr, workspace, timeout=3.0):
    """The workspace's tiled layout, after giving a switch to dwindle time to land."""
    deadline = time.monotonic() + timeout
    while True:
        mode = next((w.get("tiledLayout") for w in hypr.workspaces()
                     if str(w.get("id")) == workspace or w.get("name") == workspace), None)
        if mode in (None, "dwindle") or time.monotonic() > deadline:
            return mode
        hypr.sleep(0.15)


def arrange_target(hypr, target, slots, result, log):
    """Pin the windows of one screen to its tile tree.

    Hyprland's dwindle layout builds its tree from the order windows arrive in,
    and "preselect" tells it where the next one goes. So the windows are put
    aside, then brought back one by one: the first fills the workspace, and
    every other lands beside the window that owns the region it splits.
    """
    mine = sorted((s for s in slots if s["target"] is target), key=lambda s: s["order"])
    tree = prune_tree(annotate_tree(target["tree"], list(mine)))
    if tree is None:
        return
    windows = [s["window"] for s in mine if s["window"] is not None]
    workspace = target["workspace"]
    if target["layout"] and target["layout"] != "dwindle":
        result["warnings"].append("free layout: workspace %s is using %s, not dwindle" % (workspace, target["layout"]))
        return
    if len(windows) < 2:
        return
    if not hypr.dry_run:
        mode = wait_for_dwindle(hypr, workspace)
        if mode and mode != "dwindle":
            result["warnings"].append("free layout: workspace %s is using %s, not dwindle" % (workspace, mode))
            return
        if hypr.option_int("dwindle:preserve_split") == 0:
            result["warnings"].append("enable dwindle:preserve_split so the sizes keep their meaning")
        if tree_matches(tree, hypr.clients(), workspace):
            log("workspace %s is already laid out as requested" % workspace)
            return

    def focus(w):
        hypr.dispatch("hl.dsp.focus({ window = %s })" % lua_str("address:" + w["address"]))

    def put(w, where):
        return hypr.dispatch("hl.dsp.window.move({ workspace = %s, follow = false, window = %s })" % (
            lua_str(where), lua_str("address:" + w["address"])))

    def build(node):
        if "slot" in node:
            return
        anchor, other = first_window(node["a"]), first_window(node["b"])
        focus(anchor)
        hypr.dispatch("hl.dsp.layout(%s)" % lua_str("preselect " + PRESELECT[node["split"]]))
        put(other, workspace)
        delta = 2 * split_ratio(node) - 1
        if abs(delta) >= 0.005:
            focus(other)
            hypr.dispatch("hl.dsp.layout(%s)" % lua_str("splitratio %.3f" % delta))
        build(node["a"])
        build(node["b"])

    log("laying out %d windows on workspace %s" % (len(windows), workspace))
    for w in windows:
        put(w, PARK_WORKSPACE)
    try:
        put(first_window(tree), workspace)
        build(tree)
    finally:
        # Whatever happens, nothing stays in the parking workspace.
        if not hypr.dry_run:
            for w in hypr.clients():
                if (w.get("workspace") or {}).get("name") == PARK_WORKSPACE:
                    put(w, workspace)


def parked(clients):
    """Windows a layout put aside and never brought back (the run was killed)."""
    return [w for w in clients if (w.get("workspace") or {}).get("name") == PARK_WORKSPACE]


def unpark(hypr, monitors, clients):
    """Bring parked windows back to the workspace in front of the user."""
    mon = next((m for m in monitors if m.get("focused")), None) or next(iter(sorted_monitors(monitors)), None)
    workspace = str(((mon or {}).get("activeWorkspace") or {}).get("id", ""))
    moved = 0
    for w in parked(clients):
        if workspace and hypr.dispatch("hl.dsp.window.move({ workspace = %s, follow = false, window = %s })" % (
                lua_str(workspace), lua_str("address:" + w["address"]))):
            moved += 1
    return moved


def apply_preset(preset, hypr, timeout=None, log=None):
    log = log or (lambda msg: None)
    monitors = hypr.monitors()
    clients = hypr.clients()
    if parked(clients):
        log("bringing back %d window(s) left aside by an interrupted layout" % len(parked(clients)))
        unpark(hypr, monitors, clients)
        if not hypr.dry_run:
            clients = hypr.clients()
    targets, unresolved = build_targets(preset, monitors)
    if not targets:
        raise PresetError("none of this preset's screens matches a connected monitor")
    slots = build_slots(targets)
    # Arranging tiles has to focus windows; the user's own focus is put back after.
    active = next((w for w in clients if w.get("focusHistoryID") == 0 and not is_minimized(w)), None)
    result = {"ok": True, "moved": 0, "launched": 0, "kept": 0, "hidden": 0,
              "missing": [], "notInstalled": [], "warnings": [], "unresolved": unresolved}
    for key in unresolved:
        result["warnings"].append("screen \"%s\" not found, skipped" % key)

    # 1. Show the requested workspaces and set their layouts first, so windows
    #    land on what the user will actually see.
    explicit = [t for t in targets if t["explicit"]]
    if explicit:
        workspaces = hypr.workspaces()
        for t in explicit:
            show_workspace(hypr, t, workspaces)
    for t in targets:
        if t["layout"]:
            set_layout(hypr, t)

    # 2. Reuse windows that are already open.
    taken = claim_existing(slots, clients)
    for slot in slots:
        w = slot["window"]
        if w is None:
            continue
        if window_rank(w, slot["target"]) == 0:
            result["kept"] += 1
            continue
        log("moving %s -> workspace %s" % (slot["name"], slot["target"]["workspace"]))
        if move_window(hypr, w, slot["target"]["workspace"]):
            result["moved"] += 1

    # 3. Put away everything else on the target workspaces if asked to.
    if preset.get("others") == "minimize":
        target_ws = {t["workspace"] for t in targets}
        for w in clients:
            ws = w.get("workspace") or {}
            if w["address"] in taken or not claimable(w) or is_minimized(w):
                continue
            if str(ws.get("id")) in target_ws:
                hypr.dispatch("hl.dsp.window.tag({ tag = %s, window = %s })" % (
                    lua_str("+" + MINIMIZED_TAG_PREFIX + str(ws.get("id"))), lua_str("address:" + w["address"])))
                hypr.dispatch("hl.dsp.window.move({ workspace = %s, follow = false, window = %s })" % (
                    lua_str(MINIMIZED_WORKSPACE), lua_str("address:" + w["address"])))
                result["hidden"] += 1

    # 4. Launch what is missing, then wait for the windows and put them in place.
    pending = []
    for slot in slots:
        if slot["window"] is None:
            if not (slot["app"].get("exec") or "").strip():
                result["warnings"].append("\"%s\" has no exec command" % slot["name"])
                continue
            if not command_installed(slot["app"]["exec"]):
                program = command_program(slot["app"]["exec"])
                result["warnings"].append("\"%s\" is not installed (%s not found)" % (slot["name"], program))
                result["notInstalled"].append(slot["name"])
                continue
            log("launching %s on workspace %s" % (slot["name"], slot["target"]["workspace"]))
            if launch(hypr, slot):
                result["launched"] += 1
                pending.append(slot)
            else:
                result["missing"].append(slot["name"])

    known = {w["address"] for w in clients}
    trackable = [s for s in pending if s["cls_re"] is not None or s["title_re"] is not None]
    if trackable and not hypr.dry_run:
        limit = float(timeout if timeout is not None else preset.get("timeout", DEFAULT_TIMEOUT))
        deadline = time.monotonic() + max(1.0, limit)
        while trackable and time.monotonic() < deadline:
            hypr.sleep(POLL_INTERVAL)
            for w in hypr.clients():
                if w["address"] in known or not claimable(w):
                    continue
                slot = next((s for s in trackable if window_matches(w, s["cls_re"], s["title_re"])), None)
                if slot is None:
                    continue
                known.add(w["address"])
                trackable.remove(slot)
                slot["window"] = w
                if window_rank(w, slot["target"]) != 0:
                    move_window(hypr, w, slot["target"]["workspace"])
        for slot in trackable:
            result["missing"].append(slot["name"])

    # 5. Pin the windows of screens that came with a tile tree.
    for t in targets:
        if t["tree"] is not None:
            arrange_target(hypr, t, slots, result, log)

    # 6. Focus the screen the preset names, or give the focus back.
    focus = preset.get("focus")
    mon = resolve_screen(focus, sorted_monitors(monitors)) if focus else None
    if mon is not None:
        hypr.dispatch("hl.dsp.focus({ monitor = %s })" % lua_str(mon["name"]))
    elif active is not None and any(t["tree"] is not None for t in targets):
        hypr.dispatch("hl.dsp.focus({ window = %s })" % lua_str("address:" + active["address"]))

    if result["missing"]:
        result["ok"] = False
        result["warnings"].append("did not appear in time: " + ", ".join(result["missing"]))
    if not hypr.dry_run and any(t["layout"] for t in targets) and shutil.which("omarchy-shell"):
        subprocess.run(["omarchy-shell", "-q", "omarchy.workspaces", "refresh"], capture_output=True, timeout=5)
    return result


# --------------------------------------------------------------------------
# Listing (what the bar panel shows)
# --------------------------------------------------------------------------

def layout_tiles(windows, aspect, mode=""):
    """Where each window lands on its screen, in 0..1 coordinates.

    A sketch of Hyprland's layouts for the preview: dwindle halves the
    remaining space along its longer side for every new window, scrolling
    puts windows side by side in columns, floating cascades them.
    """
    n = len(windows)
    rects = []
    if n == 0:
        return []
    if mode == "scrolling":
        rects = [(i / n, 0.0, 1.0 / n, 1.0) for i in range(n)]
    elif mode == "floating":
        step = 0.08 if n > 1 else 0.0
        size = max(0.4, 0.7 - step * (n - 1))
        rects = [(0.15 + step * i, 0.15 + step * i, size, size) for i in range(n)]
    else:
        x, y, w, h = 0.0, 0.0, 1.0, 1.0
        for i in range(n):
            if i == n - 1:
                rects.append((x, y, w, h))
            elif w * aspect >= h:
                rects.append((x, y, w / 2, h))
                x, w = x + w / 2, w / 2
            else:
                rects.append((x, y, w, h / 2))
                y, h = y + h / 2, h / 2
    out = []
    for win, (x, y, w, h) in zip(windows, rects):
        tile = dict(win)
        tile.update({"x": round(x, 4), "y": round(y, 4), "w": round(w, 4), "h": round(h, 4)})
        out.append(tile)
    return out


def app_library(data):
    """Commands the picker offers beside the installed apps.

    Every app already used by a preset (flat or tile) is reusable, so a command
    typed once, like Claude Code in a foot terminal, is one click away from then on.
    Apps listed under a top-level "apps" key come first. Claude Code is suggested
    when it is installed and nothing mentions it yet.
    """
    seen, out = {}, []

    def add(app):
        if not isinstance(app, dict) or not str(app.get("exec") or "").strip():
            return
        command = " ".join(str(app["exec"]).split())
        if not command_installed(command):
            # Uninstalled since the preset was made: do not offer it again.
            return
        key = (command, str(app.get("title") or ""))
        extra = {k: app[k] for k in ("class", "icon") if app.get(k)}
        if key in seen:
            # The same command again (say with its window class filled in): keep the richer entry.
            for k, v in extra.items():
                seen[key].setdefault(k, v)
            return
        entry = {k: app[k] for k in ("name", "title") if app.get(k)}
        entry.update(extra)
        entry["exec"] = command
        entry.setdefault("name", derive_class(command) or "app")
        seen[key] = entry
        out.append(entry)

    saved = data.get("apps")
    for app in saved if isinstance(saved, list) else []:
        add(app)
    for preset in data.get("presets", []):
        for _, screen in preset_screens(preset):
            for app in screen_apps(screen):
                add(app)
    if shutil.which("claude") and not any("claude" in a["exec"].lower() for a in out):
        add({"name": "Claude Code", "icon": "claude-desktop",
             "exec": "foot --app-id=claude-code --working-directory=$HOME bash -c 'claude; exec bash'"})
    return out


def describe(data, monitors, clients, exists, path=None):
    path = path or CONFIG_PATH
    mons = sorted_monitors(monitors)
    names = position_names(len(mons))
    mon_out = []
    for i, m in enumerate(mons):
        scale = m.get("scale") or 1
        w, h = m.get("width", 1920) / scale, m.get("height", 1080) / scale
        if m.get("transform", 0) in (1, 3, 5, 7):
            w, h = h, w
        mon_out.append({
            "name": m.get("name"),
            "label": monitor_label(m),
            "position": names[i],
            "width": round(w),
            "height": round(h),
            "focused": bool(m.get("focused")),
            "workspace": (m.get("activeWorkspace") or {}).get("id"),
        })

    presets_out = []
    for index, preset in enumerate(data.get("presets", [])):
        entry = {
            "id": preset_id(preset, index),
            "name": str(preset.get("name") or preset_id(preset, index)),
            "icon": str(preset.get("icon") or ""),
            "description": str(preset.get("description") or ""),
            "index": index + 1,
            "others": preset.get("others", "keep"),
            "error": "",
            "active": False,
            "unresolved": [],
            "screens": [{"monitor": m["name"], "workspace": None, "layout": "", "free": False,
                         "apps": [], "tiles": []} for m in mon_out],
        }
        try:
            targets, unresolved = build_targets(preset, monitors)
            entry["unresolved"] = unresolved
            active = bool(targets)
            for t in targets:
                column = next(s for s in entry["screens"] if s["monitor"] == t["monitor"]["name"])
                if t["explicit"]:
                    column["workspace"] = t["workspace"]
                if t["layout"]:
                    column["layout"] = t["layout"]
                visible_ws = str((t["monitor"].get("activeWorkspace") or {}).get("id", ""))
                if t["explicit"] and t["workspace"] != visible_ws:
                    active = False
                column["free"] = t["tree"] is not None
                seen = {}
                for app in t["apps"]:
                    name = app.get("name") or derive_class(app.get("exec", "")) or "app"
                    cls, title, hint = app_matcher(app)
                    cls_re = compile_regex(cls, "class", name)
                    title_re = compile_regex(title, "title", name)
                    present = sum(
                        1 for w in clients
                        if claimable(w) and not is_minimized(w)
                        and str((w.get("workspace") or {}).get("id")) == t["workspace"]
                        and window_matches(w, cls_re, title_re))
                    count = app_count(app)
                    if t["tree"] is not None:
                        # Tiles are one window each: identical tiles share the windows that exist.
                        nth = seen.get((cls, title), 0)
                        seen[(cls, title)] = nth + 1
                        present = 1 if nth < present else 0
                    if present < count:
                        active = False
                    column["apps"].append({
                        "name": str(name),
                        "count": count,
                        "present": min(present, count),
                        "installed": command_installed(app.get("exec", "")),
                        "icon": str(app.get("icon") or hint),
                    })
                column["rects"] = [r for _, r in tile_rects(t["tree"])] if t["tree"] is not None else None
            entry["active"] = active and not unresolved
            for column, mon in zip(entry["screens"], mon_out):
                windows = []
                for app in column["apps"]:
                    for n in range(app["count"]):
                        windows.append({"name": app["name"], "icon": app["icon"], "present": n < app["present"],
                                        "installed": app["installed"]})
                if column.get("rects"):
                    column["tiles"] = []
                    for win, (x, y, w, h) in zip(windows, column["rects"]):
                        tile = dict(win)
                        tile.update({"x": round(x, 4), "y": round(y, 4), "w": round(w, 4), "h": round(h, 4)})
                        column["tiles"].append(tile)
                else:
                    column["tiles"] = layout_tiles(windows, mon["width"] / max(1, mon["height"]), column["layout"])
                column.pop("rects", None)
        except PresetError as exc:
            entry["error"] = str(exc)
        except Exception as exc:
            # An odd value in a hand-edited file must not hide the other presets.
            entry["error"] = "invalid preset: %s" % exc
        presets_out.append(entry)

    hidden = sum(1 for w in clients if is_minimized(w)
                 and any(t.startswith(MINIMIZED_TAG_PREFIX) for t in window_tags(w))) + len(parked(clients))
    return {"config": path, "exists": exists, "error": "", "monitors": mon_out,
            "presets": presets_out, "hidden": hidden, "library": app_library(data)}


