def sorted_monitors(monitors):
    mons = [m for m in monitors if not m.get("disabled")]
    return sorted(mons, key=lambda m: (m.get("x", 0), m.get("y", 0), m.get("name", "")))


def position_names(n):
    if n == 1:
        return ["middle"]
    if n == 2:
        return ["left", "right"]
    if n == 3:
        return ["left", "middle", "right"]
    return [str(i + 1) for i in range(n)]


def monitor_label(m):
    model = (m.get("model") or "").strip()
    if model:
        return model
    desc = (m.get("description") or "").strip()
    return desc or m.get("name", "?")


def resolve_screen(key, mons):
    """Map a screen key to a monitor dict (mons sorted left to right)."""
    if not mons:
        return None
    raw = str(key).strip()
    low = raw.lower()
    for m in mons:
        if m.get("name", "").lower() == low:
            return m
    if low.startswith("desc:"):
        needle = low[5:].strip()
        for m in mons:
            if needle and needle in (m.get("description") or "").lower():
                return m
        return None
    if low.isdigit():
        i = int(low) - 1
        return mons[i] if 0 <= i < len(mons) else None
    pos = POSITION_ALIASES.get(low)
    if pos:
        n = len(mons)
        if pos == "left":
            return mons[0]
        if pos == "right":
            return mons[-1]
        # With an even count there is no true middle; take the left one of the pair.
        return mons[(n - 1) // 2]
    if len(low) >= 2:
        for m in mons:
            if low in (m.get("description") or "").lower():
                return m
    return None


def monitor_by_id(monitors):
    return {m.get("id"): m for m in monitors}


# --------------------------------------------------------------------------
# Matching windows to apps
# --------------------------------------------------------------------------

def webapp_class(url):
    """Class Chromium gives an --app window (mirrors omarchy-webapp-window-class)."""
    address = url.split("://", 1)[1] if "://" in url else url
    address = re.split(r"[?#]", address, maxsplit=1)[0]
    host, _, rest = address.partition("/")
    path = "/" + rest if _ else ""
    host = host.rsplit("@", 1)[-1].split(":", 1)[0].lower()
    return ("chrome-%s_%s-Default" % (host, path or "/")).replace("/", "_")


def exec_tokens(command):
    try:
        return shlex.split(command or "")
    except ValueError:
        return (command or "").split()


def derive_class(command):
    """Best guess at the window class an exec line produces."""
    tokens = exec_tokens(command)
    i = 0
    while i < len(tokens):
        tok = tokens[i]
        base = os.path.basename(tok)
        if base in WRAPPERS or ("=" in tok and not tok.startswith("-")):
            i += 1
            continue
        if tok.endswith(".desktop"):
            return tok[: -len(".desktop")]
        if base == "flatpak":
            # flatpak run [options] <app id>: the window is named after the app id.
            rest = tokens[i + 1:]
            if rest and rest[0] == "run":
                for arg in rest[1:]:
                    if not arg.startswith("-") and not arg.startswith("@@"):
                        return arg
            return base
        if base == "omarchy-launch-webapp" and i + 1 < len(tokens):
            return webapp_class(tokens[i + 1])
        if base in ("omarchy-launch-or-focus-webapp",) and i + 2 < len(tokens):
            return webapp_class(tokens[i + 2])
        flags = TERMINAL_CLASS_FLAGS.get(base)
        if flags:
            rest = tokens[i + 1:]
            for j, arg in enumerate(rest):
                for flag in flags:
                    if arg == flag and j + 1 < len(rest):
                        return rest[j + 1]
                    if arg.startswith(flag + "="):
                        return arg.split("=", 1)[1]
                if arg in ("-e", "--"):
                    break
        return base
    return ""


# The command a browser is started with is rarely the class its windows get
# (helium-browser opens "helium" windows, google-chrome-stable "google-chrome").
KNOWN_CLASSES = {
    "helium-browser": ["helium"],
    "helium": ["helium"],
    "google-chrome-stable": ["google-chrome"],
    "google-chrome-beta": ["google-chrome-beta"],
    "google-chrome-unstable": ["google-chrome-unstable"],
    "chromium-browser": ["chromium"],
    "brave": ["brave-browser"],
    "brave-browser": ["brave-browser"],
    "brave-browser-beta": ["brave-browser-beta"],
    "microsoft-edge-stable": ["microsoft-edge"],
    "microsoft-edge-beta": ["microsoft-edge-beta"],
    "vivaldi": ["vivaldi-stable"],
    "zen-browser": ["zen", "zen-alpha", "zen-beta"],
    "zen": ["zen", "zen-alpha", "zen-beta"],
    "firefox-developer-edition": ["firefoxdeveloperedition", "firefox-developer-edition"],
    "thorium-browser": ["thorium"],
    "code": ["code", "code-oss", "Code"],
    "code-oss": ["code-oss", "Code - OSS"],
    "telegram-desktop": ["org.telegram.desktop"],
    "spotify-launcher": ["spotify"],
    "obsidian": ["obsidian"],
}
CLASS_SUFFIXES = ("-stable", "-browser", "-bin", "-desktop", "-launcher")


def derive_classes(command):
    """Every window class the exec line may produce, most likely first."""
    first = derive_class(command)
    if not first:
        return []
    out = [first]
    if REVERSE_DNS.match(first):
        # A flatpak id (com.stremio.Stremio): many apps name their window after its last part.
        tail = first.rsplit(".", 1)[-1]
        out += [tail, tail.lower()]
    for alias in KNOWN_CLASSES.get(first.lower(), []):
        if alias not in out:
            out.append(alias)
    for suffix in CLASS_SUFFIXES:
        if first.lower().endswith(suffix) and len(first) > len(suffix):
            stripped = first[: -len(suffix)]
            if stripped not in out:
                out.append(stripped)
    return out


def app_matcher(app):
    """(class_regex, title_regex, class_hint) for an app entry."""
    cls = app.get("class") or ""
    title = app.get("title") or ""
    hint = ""
    if cls:
        hint = re.sub(r"[\^\$\\]|\(\?i\)", "", cls)
    else:
        derived = derive_classes(app.get("exec", ""))
        for extra in desktop_app_ids(app.get("exec", "")):
            if extra.lower() not in [c.lower() for c in derived]:
                derived.append(extra)
        if derived:
            cls = "^(?:" + "|".join(re.escape(c) for c in derived) + ")$"
            hint = derived[0]
    return cls, title, hint


def desktop_app_ids(command):
    """Desktop ids (org.gnome.Nautilus) of the entries that run exactly this command.

    Wayland apps name their window after their desktop id, which the command
    does not tell: nautilus opens org.gnome.Nautilus windows.
    """
    wanted = " ".join(strip_field_codes(command).split())
    if not wanted:
        return []
    return [stem for stem, fields in desktop_index()
            if REVERSE_DNS.match(stem) and " ".join(strip_field_codes(fields.get("Exec", "")).split()) == wanted]


def check_app(app):
    """A hand-edited app with a number where text belongs gets a clear error."""
    for field in ("name", "exec", "class", "title", "icon"):
        value = app.get(field)
        if value is not None and not isinstance(value, str):
            name = app.get("name") if isinstance(app.get("name"), str) else app.get("exec")
            raise PresetError("\"%s\" of app \"%s\" must be text" % (field, name))


def command_program(command):
    """The program an exec line runs (wrappers skipped), or "" when unclear."""
    tokens = exec_tokens(command)
    for tok in tokens:
        base = os.path.basename(tok)
        if base in WRAPPERS or ("=" in tok and not tok.startswith("-")):
            continue
        return tok
    return ""


def command_installed(command):
    """False only when the program of an exec line is known to be missing."""
    program = command_program(command)
    if not program or "$" in program or program.startswith("~"):
        return True
    if program.startswith("/"):
        return os.path.exists(program)
    return shutil.which(program) is not None


def compile_regex(pattern, what, app_name):
    if not pattern:
        return None
    try:
        return re.compile(pattern, re.IGNORECASE)
    except re.error as exc:
        raise PresetError("invalid %s regex for \"%s\": %s" % (what, app_name, exc))


def window_matches(window, cls_re, title_re):
    if cls_re is None and title_re is None:
        return False
    klass = window.get("class") or ""
    initial = window.get("initialClass") or ""
    if cls_re is not None and not (cls_re.search(klass) or cls_re.search(initial)):
        return False
    if title_re is not None and not title_re.search(window.get("title") or ""):
        return False
    return True


def window_tags(window):
    return [str(t).rstrip("*") for t in (window.get("tags") or [])]


def is_minimized(window):
    return (window.get("workspace") or {}).get("name") == MINIMIZED_WORKSPACE


def claimable(window):
    """Regular windows, plus ones parked on Omarchy's minimized workspace."""
    if not window.get("mapped", True):
        return False
    ws = window.get("workspace") or {}
    if is_minimized(window):
        return True
    return isinstance(ws.get("id"), int) and ws.get("id") > 0


# --------------------------------------------------------------------------
# Planning
# --------------------------------------------------------------------------

def build_targets(preset, monitors):
    """Resolve every screen of a preset to a monitor and a workspace."""
    mons = sorted_monitors(monitors)
    targets = []
    unresolved = []
    for key, screen in preset_screens(preset):
        mon = resolve_screen(key, mons)
        if mon is None:
            unresolved.append(key)
            continue
        ws = screen.get("workspace")
        explicit = ws not in (None, "", "active")
        if explicit:
            ws = str(ws)
        else:
            ws = str((mon.get("activeWorkspace") or {}).get("id", ""))
        layout = screen.get("layout")
        if layout and layout not in LAYOUTS:
            raise PresetError("unknown layout \"%s\" (choices: %s)" % (layout, ", ".join(LAYOUTS)))
        apps = screen_apps(screen)
        for app in apps:
            check_app(app)
        tree = clean_tree(screen["tiles"]) if screen.get("tiles") else None
        if tree is not None and not layout:
            # Pinning windows to places only means something in dwindle (a tree of
            # splits). In scrolling they would be columns, some off the screen.
            layout = "dwindle"
        targets.append({
            "key": key,
            "monitor": mon,
            "workspace": ws,
            "explicit": explicit,
            "layout": layout,
            "apps": apps,
            "tree": tree,
        })
    return targets, unresolved


def build_slots(targets):
    slots = []
    for t_index, target in enumerate(targets):
        for a_index, app in enumerate(target["apps"]):
            name = app.get("name") or derive_class(app.get("exec", "")) or "app"
            cls, title, hint = app_matcher(app)
            cls_re = compile_regex(cls, "class", name)
            title_re = compile_regex(title, "title", name)
            for n in range(app_count(app)):
                slots.append({
                    "target": target,
                    "app": app,
                    "name": name,
                    "cls_re": cls_re,
                    "title_re": title_re,
                    "hint": hint,
                    "specific": 0 if title_re is not None else 1,
                    "order": (t_index, a_index, n),
                    "window": None,
                })
    return slots


def window_rank(window, target):
    ws = window.get("workspace") or {}
    if str(ws.get("id")) == target["workspace"] or ws.get("name") == target["workspace"]:
        return 0
    if window.get("monitor") == target["monitor"].get("id") and not is_minimized(window):
        return 1
    if is_minimized(window):
        return 3
    return 2


def claim_existing(slots, clients):
    """Give each slot an open window, preferring ones already in place."""
    taken = set()
    windows = [w for w in clients if claimable(w)]
    # Slots that name a title go first, so a generic "any Chrome" slot cannot
    # keep the one Chrome window a "Docs" slot asks for. Within each group,
    # pass 1 keeps windows already on their target workspace and pass 2 fills
    # the rest from anywhere, nearest first.
    for group in (0, 1):
        ordered = sorted((s for s in slots if s["specific"] == group), key=lambda s: s["order"])
        claim_group(ordered, windows, taken)
    return taken


def claim_group(ordered, windows, taken):
    for max_rank in (0, 3):
        for slot in ordered:
            if slot["window"] is not None or not slot["app"].get("reuse", True):
                continue
            best = None
            for w in windows:
                if w["address"] in taken or not window_matches(w, slot["cls_re"], slot["title_re"]):
                    continue
                rank = window_rank(w, slot["target"])
                if rank > max_rank:
                    continue
                key = (rank, w.get("focusHistoryID", 999))
                if best is None or key < best[0]:
                    best = (key, w)
            if best is not None:
                slot["window"] = best[1]
                taken.add(best[1]["address"])
    return taken


